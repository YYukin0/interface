# Copy to `.env` and fill in. Nothing here is read by replay — see AGENTS.md I1.

# ---------------------------------------------------------------------------
# Discovery only. Step 1 of the demo path is the only one that calls a model.
# ---------------------------------------------------------------------------

# Deliberately its own variable rather than the ambient ANTHROPIC_API_KEY. On a
# developer machine that one usually points at whatever tooling that developer
# runs, and a discovery run conducted by a model the evidence cannot name has
# fictional provenance. Requiring its own name means a run either has
# credentials chosen for it or does not start.
CUA_LLM_API_KEY=

# Optional. Defaults to claude-opus-5.
CUA_LLM_MODEL=claude-opus-5

# Optional. For an Anthropic-compatible endpoint that is not api.anthropic.com.
# CUA_LLM_BASE_URL=

# ---------------------------------------------------------------------------
# The target application. Used by both discovery and replay.
# ---------------------------------------------------------------------------

# Credentials for the fixture app. Never written to artifacts, logs, or prompts:
# every sink passes through the redactor first (I3). Defaults are the fixture's
# own published demo values, so both scripts run without setting these at all.
CUA_APP_USERNAME=teller01
CUA_APP_PASSWORD=letmein

# Where the application lives is NOT here. Discovery takes it from the job file
# (`entryUrl` in jobs/*.json) and replay from the artifact's own
# `surface.entryPoint`, overridable with `--origin`. A capability that ran
# against an origin nobody recorded would be evidence of nothing.
