# Discovery runs only. Replay never reads this — see AGENTS.md invariant I1.
ANTHROPIC_API_KEY=

# Model used for discovery.
CUA_DISCOVERY_MODEL=claude-opus-5

# Entry point for the local legacy target application.
CUA_TARGET_URL=http://localhost:8080/admin/index.htm

# Credentials for the target app. Never written to artifacts, logs, or prompts.
CUA_APP_USERNAME=
CUA_APP_PASSWORD=
